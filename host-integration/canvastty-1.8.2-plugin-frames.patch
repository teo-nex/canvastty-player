diff --git a/src/renderer/src/lib/skinStyles.ts b/src/renderer/src/lib/skinStyles.ts
index cf1da9e..7050595 100644
--- a/src/renderer/src/lib/skinStyles.ts
+++ b/src/renderer/src/lib/skinStyles.ts
@@ -298,7 +298,13 @@ export function scopeTerminalBorderSkinCss(css: unknown, skinId: unknown, target
     if (close < 0) return null;
     const body = source.slice(open + 1, close);
     if (!hasValidDeclarations(body)) return null;
-    output.push(`${selectors.map((selector) => scopeSelector(selector, scope, target)).join(", ")} { ${body.trim()} }`);
+    const scopedSelectors = selectors.flatMap((selector) => {
+      const scoped = scopeSelector(selector, scope, target);
+      return target === "card"
+        ? [scoped, scopeSelector(selector, scope.replace(".terminal-card[", ".plugin-canvas-card["), target)]
+        : [scoped];
+    });
+    output.push(`${scopedSelectors.join(", ")} { ${body.trim()} }`);
     cursor = close + 1;
   }
 
